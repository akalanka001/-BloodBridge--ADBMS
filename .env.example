# ==============================================================================
# BloodBridge Environment Configuration
# Copy this file to .env and configure for your chosen setup.
# Do NOT commit your actual .env file to Git!
# ==============================================================================

# Application Security (Required for all options)
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# ------------------------------------------------------------------------------
# OPTION 1: Docker Compose (Default - if you have Docker Desktop installed)
# ------------------------------------------------------------------------------
POSTGRES_USER=bloodbridge
POSTGRES_DB=bloodbridge
POSTGRES_PASSWORD=choose_a_strong_local_docker_password

# ------------------------------------------------------------------------------
# OPTION 2: Local PostgreSQL (If you DO NOT have Docker, using pgAdmin/PostgreSQL)
# ------------------------------------------------------------------------------
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your_local_postgres_password
# PGDATABASE=bloodbridge

# ------------------------------------------------------------------------------
# OPTION 3: Supabase Cloud Database (If you DO NOT have Docker and want cloud DB)
# ------------------------------------------------------------------------------
# Paste the connection string from your Supabase Project Settings -> Database:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Or using Supabase connection pooler:
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
