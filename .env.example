# ==============================================================================
# BloodBridge — Environment Variables Template (.env.example)
#
# INSTRUCTIONS FOR TEAMMATES:
# 1. NO DOCKER REQUIRED: If you do not have Docker, that is completely fine!
#    Choose Option 2 (Local PostgreSQL) OR Option 3 (Supabase Cloud) below.
#    You can then run the entire app using:
#      npm run db:migrate   (to set up tables)
#      npm run dev:local    (to start backend + frontend together)
#
# 2. Copy this file to create your private `.env` file:
#      cp .env.example .env        (Linux / macOS / Git Bash)
#      copy .env.example .env      (Windows Command Prompt)
#      Copy-Item .env.example .env (Windows PowerShell)
#
# 3. Choose ONE database setup (Option 1, 2, or 3) below and fill in your credentials.
# 4. WARNING: Never commit your actual `.env` file containing real passwords to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# ⚙️ General Server & Authentication Settings
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
JWT_SECRET=bloodbridge_dev_secret_key_change_me_to_random_32_characters_minimum
DEMO_PASSWORD=ChooseAStrongDemoPassword123!

# Frontend proxy destination (Only needed if running frontend without Docker)
# Default is http://127.0.0.1:4000. Docker automatically uses http://api:4000.
API_TARGET=http://127.0.0.1:4000


# ==============================================================================
# 🗄️ DATABASE CONNECTION: CHOOSE ONE OF THE 3 OPTIONS BELOW
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION 1: Docker Compose (Default — if you have Docker Desktop running)
# ------------------------------------------------------------------------------
# In Docker, the database service is named "db".
# On your host computer, port 5433 connects to the Docker database.
POSTGRES_USER=bloodbridge
POSTGRES_DB=bloodbridge
POSTGRES_PASSWORD=bloodbridge_local_password_123

# Host port for Docker (used by host scripts like db:ping or db:migrate)
PGPORT=5433


# ------------------------------------------------------------------------------
# OPTION 2: Local PostgreSQL (If you DO NOT have Docker, using pgAdmin/PostgreSQL)
# ------------------------------------------------------------------------------
# Uncomment and fill these in if you have PostgreSQL installed directly on your laptop:
#
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your_actual_local_postgres_password
# PGDATABASE=bloodbridge


# ------------------------------------------------------------------------------
# OPTION 3: Supabase Cloud PostgreSQL (If you DO NOT have Docker and want cloud DB)
# ------------------------------------------------------------------------------
# Free cloud database setup:
# 1. Sign up at https://supabase.com and create a new project.
# 2. Go to Project Settings -> Database -> Connection String.
# 3. Copy the URI and paste it below (replace [YOUR-PASSWORD] with your database password):
#
# --- Method 3A: Full Connection String URI (Recommended) ---
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
#
# Or with Supabase Transaction Connection Pooler (Port 6543):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
#
# --- Method 3B: Individual Parameters (Alternative to DATABASE_URL) ---
# PGHOST=db.[YOUR-PROJECT-REF].supabase.co
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your_supabase_database_password
# PGDATABASE=postgres
# PGSSLMODE=require
